# PostgreSQL пайвастшавӣ / Подключение к PostgreSQL
DATABASE_URL="postgresql://hisob:hisob@localhost:5432/hisob_pro?schema=public"
# Базаи алоҳида барои тестҳо (ҳангоми тест ҳамааш тоза мешавад!)
TEST_DATABASE_URL="postgresql://hisob:hisob@localhost:5432/hisob_pro_test?schema=public"

PORT=4000
NODE_ENV=development
# Суроғаи frontend (барои CORS ва линки барқарорсозии парол)
APP_URL="http://localhost:5173"
# Сабти ном: first-user (танҳо ҳисоби аввал — платформаи шахсӣ), open (ҳама), closed
REGISTRATION=first-user
# Муҳлати сессия (рӯз)
SESSION_TTL_DAYS=14

# Почта (ихтиёрӣ). Агар холӣ бошад, линки барқарорсозии парол дар консол чоп мешавад.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HISOB PRO <no-reply@hisob.pro>"

# Telegram-бот (ихтиёрӣ): токен аз @BotFather. Webhook танҳо бо суроғаи https кор мекунад.
TELEGRAM_BOT_TOKEN=
