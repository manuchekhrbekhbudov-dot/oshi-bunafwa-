// HISOB PRO — схемаи базаи додаҳо
// Ҳамаи маблағҳо Decimal(18,2) мебошанд (на float).
// Ҳамаи вақтҳо дар UTC нигоҳ дошта мешаванд; ҳисоботҳо дар минтақаи Asia/Dushanbe ҳисоб мешаванд.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  TJS
  USD
  RUB
}

enum Language {
  tg
  ru
}

enum AccountType {
  CASH     // Пули нақд
  CARD     // Корти бонкӣ
  BANK     // Ҳисоби бонкӣ
  EWALLET  // Ҳамёни электронӣ
}

enum PaymentMethod {
  CASH
  CARD
  BANK
}

enum CategoryKind {
  INCOME
  EXPENSE
}

// Намуди амалиёт. Танҳо INCOME ва EXPENSE дар ҳисоботи фоида/зарар ҳисоб мешаванд.
// Интиқолҳо ва амалиётҳои қарзӣ танҳо ба баланси ҳисоб таъсир мерасонанд.
enum TxType {
  INCOME          // + Даромад
  EXPENSE         // − Хароҷот
  TRANSFER_IN     // + Интиқол ба ҳисоб
  TRANSFER_OUT    // − Интиқол аз ҳисоб
  DEBT_LENT       // − Қарз додам
  DEBT_BORROWED   // + Қарз гирифтам
  DEBT_COLLECTED  // + Қарзи додашуда баргашт
  DEBT_REPAID     // − Қарзи гирифташударо пардохтам
}

enum DebtDirection {
  LENT      // Ман ба касе қарз додам
  BORROWED  // Ман аз касе қарз гирифтам
}

model User {
  id             String   @id @default(cuid())
  email          String?  @unique // ихтиёрӣ — корбарони Telegram метавонанд бо рақам ворид шаванд
  phone          String?  @unique // рақами тасдиқшуда аз Telegram (+992...) — як ҳисоб барои як рақам
  telegramUserId String?  @unique // id-и корбар дар Telegram — як ҳисоб барои як Telegram
  name           String
  passwordHash String
  language     Language @default(tg)
  baseCurrency Currency @default(TJS)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  resetTokens   PasswordResetToken[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  transfers     Transfer[]
  debts         Debt[]
  debtPayments  DebtPayment[]
  exchangeRates ExchangeRate[]
  telegram      TelegramLink?
  telegramCodes TelegramLinkCode[]
  photos        TransactionPhoto[]
  routines      Routine[]
  routinesAskedAt DateTime? // саволи «пулро дар куҷо сарф мекунед?» пурсида шуд
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0) // кӯшишҳои нодурусти код (5 → код бекор мешавад)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  currency       Currency    @default(TJS)
  initialBalance Decimal     @default(0) @db.Decimal(18, 2)
  color          String      @default("#8b5cf6")
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions   Transaction[]
  transfersFrom  Transfer[]    @relation("TransferFrom")
  transfersTo    Transfer[]    @relation("TransferTo")
  debts          Debt[]
  debtPayments   DebtPayment[]

  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      CategoryKind
  color     String       @default("#8b5cf6")
  icon      String       @default("circle")
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())

  transactions Transaction[]
  routines     Routine[]

  @@unique([userId, kind, name])
  @@index([userId, kind])
}

model Transaction {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type          TxType
  amount        Decimal        @db.Decimal(18, 2) // ҳамеша мусбат; аломат аз type муайян мешавад
  currency      Currency
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurredAt    DateTime
  source        String?        // Манбаи даромад
  purpose       String?        // Барои чӣ сарф шуд
  paymentMethod PaymentMethod?
  note          String?
  transferId    String?
  transfer      Transfer?      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  debtId        String?
  debt          Debt?          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  debtPaymentId String?        @unique
  debtPayment   DebtPayment?   @relation(fields: [debtPaymentId], references: [id], onDelete: Cascade)
  photo         TransactionPhoto?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([accountId])
}

model Transfer {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amountFrom    Decimal  @db.Decimal(18, 2)
  amountTo      Decimal  @db.Decimal(18, 2) // агар асъорҳо гуногун бошанд, бо қурби воридшуда
  occurredAt    DateTime
  note          String?
  createdAt     DateTime @default(now())

  transactions Transaction[]

  @@index([userId, occurredAt])
}

model Debt {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction    DebtDirection
  counterparty String        // Ба кӣ / аз кӣ
  phone        String?
  amount       Decimal       @db.Decimal(18, 2)
  currency     Currency
  accountId    String?       // ҳисобе, ки пул аз он баромад / ба он даромад (ихтиёрӣ)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  issuedAt     DateTime
  dueDate      DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payments     DebtPayment[]
  transactions Transaction[]

  @@index([userId, direction])
}

model DebtPayment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtId    String
  debt      Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal   @db.Decimal(18, 2)
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paidAt    DateTime
  note      String?
  createdAt DateTime  @default(now())

  transaction Transaction?

  @@index([debtId])
}

// Қурби асъор, ки истифодабаранда худаш муайян мекунад: 1 {currency} = {rate} {baseCurrency}
model ExchangeRate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  Currency
  rate      Decimal  @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, currency])
}

// ---------------------------- Telegram-бот ----------------------------

// Пайванди ҳисоби HISOB PRO бо чати Telegram
model TelegramLink {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId        String   @unique
  username      String?
  // Саволҳои аввал: манбаи даромад ва даромади моҳона → меъёри рӯзона
  step          String   @default("income_source") // income_source | monthly_income | done
  incomeSource  String?
  monthlyIncome Decimal? @db.Decimal(18, 2)
  dailyLimit    Decimal? @db.Decimal(18, 2) // агар холӣ бошад — аз даромади моҳона ё миёнаи 30 рӯз
  notifyDaily   Boolean  @default(true)
  lastDailyDay  String?  // 'yyyy-MM-dd' — ҳисоботи рӯз фиристода шуд
  lastAlertDay  String?  // огоҳии "хароҷоти зиёд" — як бор дар рӯз
  lastReminderDay String? // ёдраскунии қарзҳо (09:00)
  lastWeeklyKey   String? // ҳисоботи ҳафтаина — душанбеи ҳафта
  lastMonthlyKey  String? // ҳисоботи моҳона — 'yyyy-MM'
  lastBackupDay   String? // нусхаи эҳтиётӣ
  // Пас аз ёдраскунии ҷадвал: ҷавоби танҳо бо рақам ("25") ба ҳамин ҷой/категория сабт мешавад
  pendingRoutineId String?
  pendingRoutineAt DateTime?
  linkedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Коди яккаратаи пайвастшавӣ (t.me/bot?start=CODE), 15 дақиқа эътибор дорад
model TelegramLinkCode {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------- Суратҳои харид ----------------------------

// Сурати харид/чек (JPEG-и фишурдашуда, ~100–300 KB). Дар база нигоҳ дошта мешавад.
model TransactionPhoto {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime           String
  size           Int
  data           Bytes
  telegramFileId String?     // агар аз Telegram омада бошад — бе боргирии дубора фиристода мешавад
  createdAt      DateTime    @default(now())

  @@index([userId, createdAt])
}

// ---------------------------- Сабти ном тавассути Telegram ----------------------------

// Сабти номи интизорӣ: то тасдиқи рақам дар Telegram (15 дақиқа)
model PendingRegistration {
  id              String   @id @default(cuid())
  codeHash        String   @unique // барои t.me/bot?start=reg_CODE
  pollTokenHash   String   @unique // браузер бо ин ҳолатро месанҷад
  name            String
  email           String?
  passwordHash    String
  language        Language @default(tg)
  chatId          String?
  completedUserId String?
  error           String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([chatId])
}

// Танзимоти умумии платформа (масалан: сабти ном кушода/пӯшида)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Ҷадвали рӯз: ҷойҳое, ки корбар ҳар рӯз меравад (масалан «Иловагӣ»: даромадан 16:00, баромадан 18:00).
/// Бот 5 дақиқа пеш аз баромадан хабар медиҳад: «лутфан пардохти хароҷотро сабт кунед».
model Routine {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  days          String    @default("1234567") // рӯзҳои ҳафта: 1 = душанбе … 7 = якшанбе
  arriveTime    String?   // соати даромадан 'HH:mm' (Asia/Dushanbe)
  leaveTime     String    // соати баромадан — хабар N дақиқа пеш аз он
  remindBefore  Int       @default(5) // дақиқа
  active        Boolean   @default(true)
  lastLeaveDay  String?   // 'yyyy-MM-dd' — хабари имрӯза фиристода шуд
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
